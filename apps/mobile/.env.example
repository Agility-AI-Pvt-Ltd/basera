# Copy to apps/mobile/.env
#
# Local Supabase (pnpm dev:supabase): use http://127.0.0.1:54321 — dev start syncs LAN IP for Expo Go.
# Hosted project: use https://YOUR_PROJECT.supabase.co — dev start leaves this URL unchanged.
# On a physical phone/Expo Go, use your PC LAN IP (same host as exp://IP:8081), not 127.0.0.1
EXPO_PUBLIC_SUPABASE_ENV=local
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
