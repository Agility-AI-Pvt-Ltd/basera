{
  "expo": {
    "name": "The Tailz Club",
    "slug": "the-tailz-club",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F9FAFB",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ankit007i.mobile"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "imageWidth": 200
        }
      ],
      "expo-web-browser",
      "expo-asset",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow The Tailz Club to access your photos for your profile picture.",
          "cameraPermission": "Allow The Tailz Club to use the camera for your profile picture."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "The Tailz Club uses your location to set your city and map pin for packs and meetups near you."
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "32be6e83-722f-4464-a56c-edeb50d5a29f"
      }
    },
    "owner": "ankit007i"
  }
}
