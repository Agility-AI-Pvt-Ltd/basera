# Supabase (same project as mobile — for /community)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Google Play listing URL (required before launch)
VITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.tailzclub.app

# Optional contact for App Store waitlist
VITE_CONTACT_EMAIL=hello@thetailzclub.app

# Activity page (/activity) — social embeds
VITE_INSTAGRAM_HANDLE=thetailzclub
VITE_YOUTUBE_CHANNEL_URL=https://www.youtube.com/@thetailzclub
# Comma-separated post URLs, e.g. https://www.instagram.com/p/ABC123/
VITE_INSTAGRAM_POST_URLS=
# Comma-separated YouTube video IDs (watch?v=ID)
VITE_YOUTUBE_VIDEO_IDS=
