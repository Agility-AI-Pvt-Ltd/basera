{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "basera-d3qc.vercel.app" }],
      "destination": "https://www.thetailzclub.com/",
      "permanent": true
    },
    {
      "source": "/tag",
      "has": [{ "type": "host", "value": "basera-d3qc.vercel.app" }],
      "destination": "https://www.thetailzclub.com/",
      "permanent": true
    },
    {
      "source": "/t/:tagCode",
      "has": [{ "type": "host", "value": "basera-d3qc.vercel.app" }],
      "destination": "https://www.thetailzclub.com/t/:tagCode",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "basera-d3qc.vercel.app" }],
      "destination": "https://www.thetailzclub.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!landing-page|images|assets|favicon\\.png).*)",
      "destination": "/index.html"
    }
  ]
}
