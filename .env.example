# Supabase (local: run `supabase status` after `pnpm dev:supabase`)
SUPABASE_ENV=local
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mobile app (copy to apps/mobile/.env)
EXPO_PUBLIC_SUPABASE_ENV=local
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Admin app (copy to apps/admin/.env)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Twilio (optional — phone OTP; test_otp numbers skip Twilio in config.toml)
SUPABASE_AUTH_SMS_TWILIO_ACCOUNT_SID=
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=
SUPABASE_AUTH_SMS_TWILIO_MESSAGE_SERVICE_SID=

# Brevo SMTP (email OTP for login/signup)
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
# Verified sender in Brevo (e.g. hello@yourdomain.com)
BREVO_SMTP_SENDER=

# AI nutrition generation (OpenRouter is OpenAI-compatible)
# Pin a predictable free model; openrouter/free randomly routes between models.
OPENAI_MODEL=minimax/minimax-m3.1-flash:free
# Comma-separated, tried in order (max 2) when the primary model times out, errors, or returns an invalid plan.
OPENAI_FALLBACK_MODELS=recursive/flint-v1.0:free,openrouter/free
# Per-model timeout in ms (default 60000). The whole request is capped at ~130s.
OPENAI_TIMEOUT_MS=60000
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
# Enable structured JSON responses for the pinned OpenRouter model.
OPENAI_JSON_MODE=true
